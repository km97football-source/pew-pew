let game;
let shop;
let instImg;
let instImg2;
let gameOverImg;
let gamePauseImg;
let bgImg;     // MENU IMAGE
let gameImg;   // GAME IMAGE


function preload() {
  bgImg = loadImage("Welcome to Jungle Adventure.png");
  instImg = loadImage("Instructions1.png");
  instImg2 = loadImage("Instructions2.png")
  gameImg = loadImage("GamePlayBackground.png");
  gameOverImg = loadImage("GameOver.png");
  gamePauseImg = loadImage("GamePaused.png");
}

class GameScreen {
  constructor() {
    this.state = "menu";

    this.buttonW = 220;
    this.buttonH = 70;

    this.bx = width / 2;
    this.by = height / 2 + 60;

    this.shopX = width / 2;
    this.shopY = height / 2 + 150;
  }

  update() {
    this.bx = width / 2;
    this.by = height / 2 + 60;

    this.shopX = width / 2;
    this.shopY = height / 2 + 150;
  }

  display() {
    if (this.state === "menu") {
      image(bgImg, 0, 0, width, height);

      textAlign(CENTER, CENTER);

      fill(255);
      textSize(60);
      text("Jungle Adventure", width / 2, height / 2 - 100);

      // START BUTTON
      fill(this.isHovering(this.bx, this.by) ? color(255,200,0) : color(255,150,0));
      rectMode(CENTER);
      rect(this.bx, this.by, this.buttonW, this.buttonH, 12);

      fill(0);
      textSize(24);
      text("START", this.bx, this.by);

      // SHOP BUTTON
      fill(this.isHovering(this.shopX, this.shopY) ? color(0,200,255) : color(0,150,255));
      rect(this.shopX, this.shopY, this.buttonW, this.buttonH, 12);

      fill(0);
      text("SHOP", this.shopX, this.shopY);

    } else if (this.state === "game") {
      image(gameImg, 0, 0, width, height);
    }
  }

  handleMousePressed() {
    if (this.state === "menu") {
      if (this.isHovering(this.bx, this.by)) {
        this.state = "game";
      }

      if (this.isHovering(this.shopX, this.shopY)) {
        this.state = "shop"; // 🔥 GO TO SHOP
      }
    }
  }

  isHovering(x, y) {
    return (
      mouseX > x - this.buttonW / 2 &&
      mouseX < x + this.buttonW / 2 &&
      mouseY > y - this.buttonH / 2 &&
      mouseY < y + this.buttonH / 2
    );
  }
}

function setup() {
  createCanvas(windowWidth, windowHeight);

  game = new GameScreen();
  shop = new Shop(); // 🔥 IMPORTANT
}

function draw() {
  if (game.state === "shop") {
    shop.display(); // 🔥 SHOW SHOP
  } else {
    game.update();
    game.display();
  }
}

function mousePressed() {
  if (game.state === "shop") {
    shop.handleMousePressed(); // 🔥 SHOP CLICKS
  } else {
    game.handleMousePressed();
  }
}

function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
}