let game;
let bgImg;     // menu image
let gameImg;   // game image

class GameScreen {
  constructor() {
    this.state = "menu";

    this.buttonW = 220;
    this.buttonH = 70;

    this.bx = width / 2;
    this.by = height / 2 + 60;
  }

  update() {
    // keep button centered on any screen size
    this.bx = width / 2;
    this.by = height / 2 + 60;
  }

  display() {
    if (this.state === "menu") {
      // MENU SCREEN IMAGE
      image(bgImg, 0, 0, width, height);

      textAlign(CENTER, CENTER);

      fill(255);
      textSize(60);
      text("Jungle Adventure", width / 2, height / 2 - 100);

      if (this.isHovering(this.bx, this.by)) {
        fill(255, 200, 0);
      } else {
        fill(255, 150, 0);
      }

      rectMode(CENTER);
      rect(this.bx, this.by, this.buttonW, this.buttonH, 12);

      fill(0);
      textSize(24);
      text("START", this.bx, this.by);

    } else if (this.state === "game") {
      // SECOND SCREEN IMAGE
      image(gameImg, 0, 0, width, height);
    }
  }

  handleMousePressed() {
    if (this.state === "menu" && this.isHovering(this.bx, this.by)) {
      this.state = "game";
    }
  }

  isHovering(x, y) {
    return (
      mouseX > x - this.buttonW / 2 &&
      mouseX < x + this.buttonW / 2 &&
      mouseY > y - this.buttonH / 2 &&
      mouseY < y + this.buttonH / 2
    );
  }
}

function preload() {
  // 👇 PUT YOUR TWO IMAGE FILE NAMES HERE
  bgImg = loadImage("Welcome to Jungle Adventure.png");
  gameImg = loadImage("JMDuHV.png");
}

function setup() {
  createCanvas(windowWidth, windowHeight); // FULL SCREEN
  game = new GameScreen();
}

function draw() {
  game.update();
  game.display();
}

// makes canvas resize with browser
function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
}

function mousePressed() {
  game.handleMousePressed();
}