



class GameScreen {
  constructor() {
    this.buttonW = 220;
    this.buttonH = 70;

    this.bx = width / 2;
    this.by = height / 2 + 60;
  }

  update() {
    // nothing needed for menu-only screen
  }

  display() {
    // draw your uploaded background
    image(bgImg, 0, 0, width, height);

    textAlign(CENTER, CENTER);

    // TITLE (optional, remove if you want only buttons)
    fill(255);
    textSize(60);
    text("Jungle Adventure", width / 2, height / 2 - 100);

    // BUTTON (hover effect)
    if (this.isHovering(this.bx, this.by)) {
      fill(255, 200, 0);
    } else {
      fill(255, 150, 0);
    }

    rectMode(CENTER);
    rect(this.bx, this.by, this.buttonW, this.buttonH, 12);

    // button text
    fill(0);
    textSize(24);
    text("START", this.bx, this.by);
  }

  handleMousePressed() {
    if (this.isHovering(this.bx, this.by)) {
      console.log("Start button clicked!");
      // later you can switch screens here
    }
  }

  isHovering(x, y) {
    return (
      mouseX > x - this.buttonW / 2 &&
      mouseX < x + this.buttonW / 2 &&
      mouseY > y - this.buttonH / 2 &&
      mouseY < y + this.buttonH / 2
    );
  }
}

function setup() {
  createCanvas(800, 600);
  game = new GameScreen();
}

function draw() {
  game.update();
  game.display();
}

function mousePressed() {
  game.handleMousePressed();
}
let game;
let bgImg; // your background image
function preload() {
  // put your image file name here
  bgImg = loadImage("+6s396.png");
}