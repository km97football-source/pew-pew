let game;
let shop;

let bgImg;     // menu image
let gameImg;   // game image

function preload() {
  // 👇 Put your image filenames here exactly
  bgImg = loadImage("Welcome to Jungle Adventure.png");
  gameImg = loadImage("JMDuHV.png");
}

// ================= GAME SCREEN =================
class GameScreen {
  constructor() {
    this.state = "menu"; // menu, game, shop

    this.buttonW = 220;
    this.buttonH = 70;

    this.bx = width / 2;
    this.by = height / 2 + 60;
  }

  update() {
    this.bx = width / 2;
    this.by = height / 2 + 60;
  }

  display() {
    // ===== MENU =====
    if (this.state === "menu") {
      image(bgImg, 0, 0, width, height);

      textAlign(CENTER, CENTER);
      fill(255);
      textSize(60);
      text("Jungle Adventure", width / 2, height / 2 - 100);

      rectMode(CENTER);

      // START BUTTON
      fill(this.isHovering(this.bx, this.by) ? color(255,200,0) : color(255,150,0));
      rect(this.bx, this.by, this.buttonW, this.buttonH, 12);
      fill(0);
      textSize(24);
      text("START", this.bx, this.by);

      // SHOP BUTTON
      let shopY = this.by + 100;
      fill(this.isHovering(this.bx, shopY) ? color(0,200,255) : color(0,150,255));
      rect(this.bx, shopY, this.buttonW, this.buttonH, 12);
      fill(0);
      text("SHOP", this.bx, shopY);
    }

    // ===== GAME =====
    else if (this.state === "game") {
      image(gameImg, 0, 0, width, height);
    }

    // ===== SHOP SCREEN =====
    else if (this.state === "shop") {
      shop.display(); // full screen shop
    }
  }

  handleMousePressed() {
    let shopY = this.by + 100;

    // START
    if (this.state === "menu" && this.isHovering(this.bx, this.by)) {
      this.state = "game";
    }

    // SHOP
    if (this.state === "menu" && this.isHovering(this.bx, shopY)) {
      this.state = "shop";
    }

    // PASS CLICK TO SHOP
    if (this.state === "shop") {
      shop.handleMousePressed();
    }
  }

  isHovering(x, y) {
    return (
      mouseX > x - this.buttonW / 2 &&
      mouseX < x + this.buttonW / 2 &&
      mouseY > y - this.buttonH / 2 &&
      mouseY < y + this.buttonH / 2
    );
  }
}

// ================= SHOP CLASS =================
class Shop {
  constructor() {
    this.coins = 20;

    this.buttonW = 260;
    this.buttonH = 60;

    this.pierceY = height / 2 - 40;
    this.doubleY = height / 2 + 40;
    this.backY = height / 2 + 140;

    this.piercingUnlocked = false;
    this.doubleUnlocked = false;
  }

  update() {
    this.pierceY = height / 2 - 40;
    this.doubleY = height / 2 + 40;
    this.backY = height / 2 + 140;
  }

  display() {
    background(20); // FULL SCREEN SHOP

    textAlign(CENTER, CENTER);

    fill(255);
    textSize(50);
    text("SHOP", width / 2, height / 2 - 200);

    textSize(22);
    text("Coins: " + this.coins, width / 2, height / 2 - 150);

    rectMode(CENTER);

    // ===== PIERCING =====
    fill(255);
    text("Piercing Shuriken\nGoes through enemies + more damage", width/2, this.pierceY - 40);

    fill(this.isHovering(width/2, this.pierceY) ? color(0,255,100) : color(0,200,100));
    rect(width / 2, this.pierceY, this.buttonW, this.buttonH, 10);

    fill(0);
    text(this.piercingUnlocked ? "OWNED" : "BUY (10)", width / 2, this.pierceY);

    // ===== DOUBLE =====
    fill(255);
    text("Double Shuriken\nThrows two at once", width/2, this.doubleY - 40);

    fill(this.isHovering(width/2, this.doubleY) ? color(0,200,255) : color(0,150,255));
    rect(width / 2, this.doubleY, this.buttonW, this.buttonH, 10);

    fill(0);
    text(this.doubleUnlocked ? "OWNED" : "BUY (15)", width / 2, this.doubleY);

    // ===== BACK BUTTON =====
    fill(255, 80, 80);
    rect(width / 2, this.backY, this.buttonW, this.buttonH, 10);
    fill(0);
    text("BACK", width / 2, this.backY);
  }

  handleMousePressed() {
    // BUY PIERCING
    if (
      this.isHovering(width / 2, this.pierceY) &&
      !this.piercingUnlocked &&
      this.coins >= 10
    ) {
      this.coins -= 10;
      this.piercingUnlocked = true;
    }

    // BUY DOUBLE
    if (
      this.isHovering(width / 2, this.doubleY) &&
      !this.doubleUnlocked &&
      this.coins >= 15
    ) {
      this.coins -= 15;
      this.doubleUnlocked = true;
    }

    // BACK TO MENU
    if (this.isHovering(width / 2, this.backY)) {
      game.state = "menu";
    }
  }

  isHovering(x, y) {
    return (
      mouseX > x - this.buttonW / 2 &&
      mouseX < x + this.buttonW / 2 &&
      mouseY > y - this.buttonH / 2 &&
      mouseY < y + this.buttonH / 2
    );
  }
}

// ================= SETUP =================
function setup() {
  createCanvas(windowWidth, windowHeight);

  game = new GameScreen();
  shop = new Shop();
}

// ================= DRAW =================
function draw() {
  game.update();
  if (game.state === "shop") shop.update();
  game.display();
}

// ================= CLICK =================
function mousePressed() {
  game.handleMousePressed();
}

// resize
function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
}